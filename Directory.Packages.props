<Project>

  <!-- Central Package Management: every package version lives here, never in a project.
       Transitive packages are not pinned: the libraries' versions below are the lowest each
       package accepts, and the tests and tools resolve whatever newer version their own
       packages need. The lock files record what each project resolved, and NuGetAudit checks
       every transitive package for known vulnerabilities. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Akinly: Microsoft's own abstractions only, so the core carries no model or database
       dependency. These are the packages' minimum versions, the oldest of the .NET 10 line, so
       an app that pins the 10.0 packages can use Akinly; raise them only when the code needs a
       newer API (Dependabot leaves them alone). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
    <PackageVersion Include="System.Numerics.Tensors" Version="10.0.0" />
  </ItemGroup>

  <!-- Build-time only, never a dependency of a package: the shipped public API is recorded in
       each library's PublicAPI.Shipped.txt, and any change to it fails the build until it is
       recorded in PublicAPI.Unshipped.txt, so no API changes by accident. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <!-- Akinly.AI: the abstractions only; you bring the provider's adapter. -->
  <ItemGroup>
    <!-- The minimum: 10.6.0 is the first version in which ChatOptions.ContinuationToken and
         AllowBackgroundResponses, which the judge and labeler clear, are no longer experimental. -->
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.6.0" />
  </ItemGroup>

  <!-- Akinly.VectorData: the abstractions only; you bring the database's connector. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.VectorData.Abstractions" Version="10.1.0" />
  </ItemGroup>

  <!-- The evaluation tool and benchmarks: not shipped. -->
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="11.0.0" />
    <PackageVersion Include="Anthropic" Version="13.8.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="11.0.0" />
    <PackageVersion Include="Parquet.Net" Version="6.1.0" />
  </ItemGroup>

  <!-- Tests -->
  <ItemGroup>
    <PackageVersion Include="CsCheck" Version="5.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="OllamaSharp" Version="5.5.2" />
    <!-- Vector database connectors, for the store's contract tests. Still pre-release upstream;
         the Akinly.VectorData package itself depends only on the stable abstractions. -->
    <PackageVersion Include="Microsoft.SemanticKernel.Connectors.InMemory" Version="1.74.0-preview" />
    <PackageVersion Include="Microsoft.SemanticKernel.Connectors.PgVector" Version="1.74.0-preview" />
    <PackageVersion Include="Microsoft.SemanticKernel.Connectors.Qdrant" Version="1.74.0-preview" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.Qdrant" Version="4.16.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

</Project>
