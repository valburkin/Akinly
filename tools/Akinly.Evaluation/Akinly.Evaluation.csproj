<Project Sdk="Microsoft.NET.Sdk">

  <!-- The evaluation and calibration tool: measures Akinly on public labeled datasets, and
       suggests thresholds for an embedding model. Not shipped as a package. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AssemblyName>akinly-eval</AssemblyName>
    <!-- A console tool, not public API: no XML comment required. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="OllamaSharp" />
    <PackageReference Include="Parquet.Net" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Akinly.AI\Akinly.AI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Akinly.Evaluation.Tests" />
  </ItemGroup>

</Project>
