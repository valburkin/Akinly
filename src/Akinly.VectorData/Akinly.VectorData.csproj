<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Akinly.VectorData</PackageId>
    <Description>An Akinly cluster store over a vector database with a Microsoft.Extensions.VectorData connector, tested with Qdrant and PostgreSQL with pgvector: one writer at a time, with a journal so a write stopped halfway is finished by the next one.</Description>
    <PackageTags>$(PackageTags);vector-database;microsoft-extensions-vectordata;qdrant;pgvector</PackageTags>
    <IsPackable>true</IsPackable>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.VectorData.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Akinly\Akinly.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Akinly.VectorData.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The package's page on nuget.org: its own README, linking to the full docs. -->
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="../../assets/icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
