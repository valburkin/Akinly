<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The .NET 10 analyzers' recommended rule set plus .editorconfig code style, enforced
         at build time. Warnings fail the build. The rule set is named, not "latest", so a
         newer SDK cannot fail an unchanged build; raise it on purpose. -->
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Every public member carries an XML comment (CS1591 stays on); the file also lets
         the build flag unused usings (IDE0005). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Restore audits every package, transitive ones included, against the known
         vulnerabilities; with warnings as errors, one found fails the build. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <!-- Resolved packages are recorded in packages.lock.json, so a build never picks up a
         version nobody reviewed. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- Package metadata for the libraries under src/. -->
  <PropertyGroup>
    <Version>1.0.1</Version>
    <!-- Pack compares each package with this release on nuget.org (EnablePackageValidation), so
         a breaking change cannot ship by accident in a minor or patch version. -->
    <PackageValidationBaselineVersion>1.0.1</PackageValidationBaselineVersion>
    <Authors>Valentin Burkin</Authors>
    <Copyright>Copyright (c) 2026 Valentin Burkin</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/valburkin/Akinly</PackageProjectUrl>
    <PackageReleaseNotes>https://github.com/valburkin/Akinly/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>clustering;text-clustering;embeddings;semantic;llm;deduplication;incremental</PackageTags>
    <RepositoryUrl>https://github.com/valburkin/Akinly</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Debug symbols go to nuget.org's symbol server as a .snupkg; Source Link (in the SDK)
         points them at this repository's sources at the packed commit. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Paths in the binaries and symbols don't depend on the machine that builds them, so a
         package never carries a local path: on for CI and for every Release build. -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true' or '$(Configuration)' == 'Release'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
